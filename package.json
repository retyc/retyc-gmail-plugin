{
  "name": "retyc-gmail-plugin",
  "version": "0.0.1",
  "private": true,
  "description": "Gmail extension for Retyc — secure, end-to-end encrypted file transfers",
  "author": "TripleStack SAS",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/retyc/retyc-gmail-plugin.git"
  },
  "homepage": "https://retyc.com",
  "bugs": {
    "url": "https://github.com/retyc/retyc-gmail-plugin/issues"
  },
  "keywords": [
    "gmail",
    "webextension",
    "chrome-extension",
    "firefox-extension",
    "retyc",
    "file-transfer",
    "encryption",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --watch --mode development",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "start": "vite --mode development",
    "package": "node scripts/package-zip.js",
    "lint:firefox": "web-ext lint --source-dir dist/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@inboxsdk/core": "^2.2.30",
    "@nuxt/ui": "^4.11.3",
    "@retyc/sdk": "^1.1.0",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.16",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.143",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@types/chrome": "^0.3.5",
    "@types/node": "^25.9.9",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13",
    "web-ext": "^10.7.0"
  }
}
